	depends = cairo
	depends = dbus
	depends = fontconfig
	depends = freetype2
	depends = inter-font
	depends = librsvg
	depends = libinput
	depends = libpipewire
	depends = systemd-libs
	depends = qt6-base
	depends = qt6-declarative
	depends = kirigami
	depends = qqc2-desktop-style
	provides = listello
	conflicts = listello
	conflicts = tiny-dfr
	options = !lto
	source = git+https://github.com/atsetilam/listello.git
