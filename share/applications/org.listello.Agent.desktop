[Desktop Entry]
Type=Application
Name=listello session agent
Comment=Supplies the Touch Bar's Dock with windows and icons
Exec=/usr/bin/listello-agent
Icon=input-keyboard
NoDisplay=true
# KWin hides these protocols from any client whose executable has no .desktop file
# declaring them. This file is what lets the agent see other windows at all, so it has to
# name the path the agent is installed at.
X-KDE-Wayland-Interfaces=org_kde_plasma_window_management,org_kde_plasma_activation_feedback,zkde_screencast_unstable_v1
# The same gate for window pictures, used only when window previews are turned on.
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
